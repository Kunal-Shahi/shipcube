# Allowlist: upload only what the three images are built from. infra/ (Terraform state settings,
# tfvars), .env files and local build output never leave the machine.
/*
!/apps/
!/services/
!/packages/
!/ml/
!/deploy/
**/node_modules/
**/.next/
**/.venv/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.tfvars
**/.terraform/
/services/gateway/gateway
