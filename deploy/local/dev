#!/usr/bin/env bash
# ShipCube local stack: deploy/local/dev <up|down|reset|migrate|seed|smoke|logs|ps>
# (the repo-root Makefile wraps these). docs/LOCAL.md explains each component and its switch.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"
STATE="$HERE/.state"
dc() { docker compose -f "$HERE/compose.yaml" "$@"; }

need() { command -v "$1" >/dev/null || { echo "missing $1 (see docs/LOCAL.md: Prerequisites)" >&2; exit 1; }; }
need docker
docker info >/dev/null 2>&1 || { echo "Docker isn't running (on macOS: colima start)" >&2; exit 1; }
[ -f .env ] || cp .env.local.example .env
# .env is generated from .env.local.example (port overrides and switches).
# shellcheck source=/dev/null
set -a; . ./.env; set +a   # port overrides and switches

services=(api worker gateway)
ollama=0
if grep -qE '^LOCAL_LLM=ollama' .env 2>/dev/null || [ "${LOCAL_LLM:-}" = ollama ]; then ollama=1; services+=(ollama); fi

migrate() {
  dc up -d --wait postgres
  dc run --rm --no-deps migrate
}

seed() {
  mkdir -p "$STATE"; chmod 700 "$STATE"
  if [ -f "$STATE/seed.env" ]; then echo "already seeded ($STATE/seed.env); 'reset' to start over"; return; fi
  local email=dev@shipcube.local out ws user pat ses app_tok app_hash
  out="$(dc run --rm --no-deps admin bootstrap --email "$email" --workspace demo --name "Local demo")"
  ws="$(echo "$out" | python3 -c 'import json,sys; print(json.loads(sys.stdin.readline())["workspace_id"])')"
  user="$(echo "$out" | python3 -c 'import json,sys; print(json.loads(sys.stdin.readline())["user_id"])')"
  pat="$(echo "$out" | sed -n 's/^PAT (shown once): //p')"
  [ -n "$pat" ] || { echo "bootstrap printed no PAT:"; echo "$out"; exit 1; }
  ses="sc_ses_$(openssl rand -hex 4)_$(openssl rand -hex 24)"
  app_tok="scg_$(openssl rand -hex 24)"
  app_hash="$(printf %s "$app_tok" | shasum -a 256 | cut -d' ' -f1)"
  umask 077
  cat > "$STATE/seed.env" <<SEED
# Written by deploy/local/dev seed. Local-only credentials for the local stack; never used elsewhere.
SHIPCUBE_SEED_EMAIL=$email
SHIPCUBE_SEED_USER_ID=$user
SHIPCUBE_DATA_WORKSPACE=$ws
SHIPCUBE_DEV_CONSOLE_EMAIL=$email
SHIPCUBE_DEV_CONSOLE_TOKEN=$ses
SHIPCUBE_PAT=$pat
SHIPCUBE_GATEWAY_APP_TOKEN=$app_tok
SEED
  python3 "$HERE/gateway_registry.py" "$app_hash" "$ws" > "$STATE/gateway-registry.json"
  chmod 644 "$STATE/gateway-registry.json"   # read by the gateway container (holds only a hash)
  echo "seeded: user $email, workspace demo ($ws); PAT and console token in $STATE/seed.env"
}

case "${1:-}" in
  up)
    dc build
    docker pull -q python:3.12-slim >/dev/null   # base of the profiler sandbox (PR #30): first estimate is faster
    migrate
    seed
    dc --profile ollama up -d --wait --remove-orphans "${services[@]}"
    if [ "$ollama" = 1 ]; then dc exec ollama ollama pull "${LOCAL_LLM_MODEL:-qwen2.5:0.5b}" >/dev/null; fi
    dc ps
    cat <<URLS

API + MCP:  http://localhost:${SHIPCUBE_API_PORT:-18080}  (MCP at /mcp; PAT in deploy/local/.state/seed.env)
Gateway:    http://localhost:${SHIPCUBE_GATEWAY_PORT:-18090}/v1
Postgres:   127.0.0.1:${SHIPCUBE_PG_PORT:-55432} (db shipcube)
Console:    cd apps/web && npm run dev   (see docs/LOCAL.md)
URLS
    ;;
  down) dc --profile ollama --profile tools down --remove-orphans ;;
  reset)
    dc --profile ollama --profile tools down --remove-orphans --volumes
    docker ps -aq --filter label=managed-by=shipcube | xargs -r docker rm -f >/dev/null
    rm -rf "$STATE"
    echo "reset: database, seed and deployed local apps removed"
    ;;
  migrate) migrate ;;
  seed) seed ;;
  smoke)
    [ -f "$STATE/seed.env" ] || { echo "run 'up' first" >&2; exit 1; }
    cd "$HERE/../.."
    export SHIPCUBE_MCP_URL="http://localhost:${SHIPCUBE_API_PORT:-18080}/mcp"
    export SHIPCUBE_GATEWAY_URL="http://localhost:${SHIPCUBE_GATEWAY_PORT:-18090}"
    exec uv run --project deploy/local/smoke python deploy/local/smoke/smoke.py "${@:2}"
    ;;
  logs) dc logs -f --tail 100 "${@:2}" ;;
  ps) dc ps ;;
  *) sed -n 2,3p "$0"; exit 2 ;;
esac
