# Host ports (change them if another process already listens there; `lsof -iTCP:<port> -sTCP:LISTEN`)
SHIPCUBE_API_PORT=18080
SHIPCUBE_GATEWAY_PORT=18090
SHIPCUBE_DB_PORT=54329
SHIPCUBE_IAP_PORT=8088
SHIPCUBE_GCS_PORT=4443
SHIPCUBE_SECRETMANAGER_PORT=8085

# Local stack switches (copied to deploy/local/.env on first `make up`; .env is gitignored).
# Each component is the real implementation; these choose local or GCP backends.

# Deployer: local (apps run as Docker containers on the shipcube-local network) | gcp
SHIPCUBE_BACKEND=local
# Monitoring for inspect_app: local (Docker stats + container logs) | gcp (Cloud Monitoring/Logging)
SHIPCUBE_MONITOR=local
# Load estimator: placement (classifier + profiler + Muse/rules explainer) | dev (canned, unit tests only)
SHIPCUBE_ESTIMATOR=placement
# Profiler sandbox: local (docker run --network none) | gcp (Cloud Run job)
SHIPCUBE_PROFILER=local

# Muse (gateway upstream, estimate explanations): put MUSE_API_KEY=... in the repo-root .env; the
# local secrets step copies it into .local/ (Secret Manager emulator). Real calls are billed.
# Without a key: LOCAL_LLM=ollama runs a small local model (~400 MB download) as the gateway's
# OpenAI-compatible upstream. Empty = no model calls (the smoke test skips them).
LOCAL_LLM=
LOCAL_LLM_MODEL=qwen2.5:0.5b
